{
  "manifest_version": 3,
  "name": "TabVault — Smart Tab Suspension & Restoration",
  "short_name": "TabVault",
  "version": "1.0.0",
  "description": "Intelligent tab suspension and restoration system. Save RAM, preserve scroll/form state, snapshot previews, and smart restore.",
  "minimum_chrome_version": "116",

  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "contextMenus",
    "notifications",
    "system.memory"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TabVault",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["suspended/suspended.html"],
      "matches": ["<all_urls>"]
    }
  ],

  "commands": {
    "suspend-current-tab": {
      "suggested_key": { "default": "Alt+S", "mac": "Alt+S" },
      "description": "Suspend the current tab"
    },
    "restore-current-tab": {
      "suggested_key": { "default": "Alt+R", "mac": "Alt+R" },
      "description": "Restore the current tab"
    },
    "suspend-all-tabs": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Suspend all tabs in this window"
    },
    "restore-all-tabs": {
      "suggested_key": { "default": "Alt+Shift+R", "mac": "Alt+Shift+R" },
      "description": "Restore all suspended tabs"
    },
    "whitelist-current-domain": {
      "description": "Add current domain to whitelist"
    },
    "open-options": {
      "description": "Open TabVault settings"
    }
  }
}
